{
    "name": "greendale-back",
    "version": "0.1.0",
    "private": true,
    "description": "Greendale school platform API (Express + PostgreSQL + Prisma + BullMQ)",
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "imports": {
        "#config/*": "./src/config/*",
        "#core/*": "./src/core/*",
        "#modules/*": "./src/modules/*",
        "#jobs/*": "./src/jobs/*"
    },
    "scripts": {
        "dev": "node --watch src/server.js",
        "dev:worker": "node --watch src/worker.js",
        "start": "node src/server.js",
        "start:worker": "node src/worker.js",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:status": "prisma migrate status",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "check:db": "node scripts/check-db.js",
        "check:redis": "node scripts/check-redis.js",
        "check:queue": "node scripts/check-queue.js",
        "check": "npm run check:db && npm run check:redis && npm run check:queue",
        "check:syntax": "node scripts/check-syntax.js"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "argon2": "0.45.1",
        "bullmq": "6.5.3",
        "cookie-parser": "1.4.7",
        "dotenv": "18.0.9",
        "express": "5.3.0",
        "helmet": "8.3.0",
        "ioredis": "6.0.0",
        "jose": "6.2.13",
        "pg": "8.23.1",
        "pino": "10.4.0",
        "pino-http": "11.0.0",
        "prisma": "7.10.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "esbuild": "0.28.2",
        "pino-pretty": "13.2.0"
    }
}
